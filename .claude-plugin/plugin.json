{
  "name": "game-design-kit",
  "version": "2.0.0",
  "description": "AI game design pipeline for mobile games: /create (idea → GCD → prototype + Figma → detail docs) with approval gates at every step. Powered by 5 game design books and Figma integration.",
  "author": {
    "name": "Game Design Kit"
  },
  "repository": "https://github.com/nguyentamdat/agent-concept",
  "license": "MIT",
  "keywords": [
    "game-design",
    "game-development",
    "prototype",
    "mda-framework",
    "knowledge-base",
    "figma"
  ],
  "mcpServers": {
    "game-design-kit": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/packages/mcp-server/dist/server.js"],
      "env": {
        "KNOWLEDGE_DIR": "${CLAUDE_PLUGIN_ROOT}/knowledge",
        "PROJECTS_DIR": "${CLAUDE_PLUGIN_ROOT}/projects",
        "TEMPLATES_DIR": "${CLAUDE_PLUGIN_ROOT}/templates",
        "CACHE_DIR": "${CLAUDE_PLUGIN_DATA}/.knowledge-cache"
      }
    },
    "figma-mcp-go": {
      "command": "npx",
      "args": ["-y", "@vkhanhqui/figma-mcp-go"]
    }
  }
}
