{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "game-design-kit",
  "version": "2.3.0",
  "description": "AI game design pipeline for mobile games: /create (idea → GCD → prototype → wireframe + detail docs) with approval gates at every step. Powered by Hindsight MCP knowledge base.",
  "author": {
    "name": "Game Design Kit"
  },
  "repository": "https://github.com/nguyentamdat/agent-concept",
  "license": "MIT",
  "keywords": [
    "game-design",
    "game-development",
    "prototype",
    "mda-framework",
    "knowledge-base",
    "wireframe"
  ],
  "mcpServers": {
    "hindsight": {
      "type": "http",
      "url": "${HINDSIGHT_MCP_URL:-https://hindsight-api.zingplay.dev/mcp/game-knowledge/}",
      "headers": {
        "Authorization": "Bearer ${HINDSIGHT_API_KEY}"
      }
    }
  }
}
