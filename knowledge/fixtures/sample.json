{
  "game_design": {
    "core_loops": {
      "primary_loop": {
        "name": "Combat Loop",
        "description": "Player engages in turn-based combat with enemies",
        "steps": [
          "Select action",
          "Execute action",
          "Receive feedback",
          "Enemy responds"
        ]
      },
      "secondary_loops": [
        {
          "name": "Resource Management",
          "description": "Managing health, mana, and stamina",
          "frequency": "continuous"
        }
      ]
    },
    "progression": {
      "level_system": {
        "max_level": 100,
        "experience_curve": "exponential",
        "rewards": ["stat_increase", "skill_unlock", "equipment_access"]
      },
      "skill_tree": {
        "branches": 3,
        "points_per_level": 1,
        "respec_allowed": true
      }
    },
    "economy": {
      "currencies": [
        {
          "name": "Gold",
          "sources": ["enemy_drops", "quest_rewards"],
          "sinks": ["equipment_purchase", "skill_training"]
        },
        {
          "name": "Gems",
          "sources": ["boss_drops", "achievements"],
          "sinks": ["cosmetics", "convenience"]
        }
      ]
    }
  }
}
