{
  "mcpServers": {
    "game-design-kit": {
      "type": "stdio",
      "command": "bun",
      "args": ["run", "./mcp-server/src/server.ts"],
      "env": {
        "KNOWLEDGE_DIR": "./knowledge",
        "PROJECTS_DIR": "./projects",
        "TEMPLATES_DIR": "./templates",
        "CACHE_DIR": "./.knowledge-cache"
      }
    },
    "hindsight": {
      "type": "http",
      "url": "https://hindsight.zingplay.dev/mcp/game-knowledge/",
      "headers": {
        "Authorization": "Bearer ${HINDSIGHT_API_KEY}"
      }
    }
  }
}
